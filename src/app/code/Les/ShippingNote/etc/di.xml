<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference
        for="Les\ShippingNote\Api\DeliveryMessageInterface"
        type="Les\ShippingNote\Model\DeliveryMessage"/>

    <!-- 設定新 Service 的建構子文字 -->
    <type name="Les\ShippingNote\Model\InternationalDeliveryMessage">
        <arguments>
            <!-- 替換字串 -->
            <argument name="introduction" xsi:type="string">International orders ship from Taiwan. Delivery charges are calculated at checkout.</argument>
        </arguments>
    </type>

    <!-- Virtual Type A：國際配送 -->
    <virtualType
        name="Les\ShippingNote\Virtual\GlobalDeliveryMessage"
        type="Les\ShippingNote\Model\InternationalDeliveryMessage">
        <arguments>
            <argument name="introduction" xsi:type="string">International delivery: orders ship from Taiwan. Review delivery charges at checkout.</argument>
        </arguments>
    </virtualType>

    <!-- Virtual Type B：下單提醒 -->
    <virtualType
        name="Les\ShippingNote\Virtual\DeliveryReminderMessage"
        type="Les\ShippingNote\Model\InternationalDeliveryMessage">
        <arguments>
            <argument name="introduction" xsi:type="string">Before ordering, review the delivery and import-charge policy for your destination.</argument>
        </arguments>
    </virtualType>

    <!-- Proxy -->
    <virtualType
        name="Les\ShippingNote\Virtual\LazyGlobalDeliveryMessage"
        type="Les\ShippingNote\Model\InternationalDeliveryMessage\Proxy">
        <arguments>
            <argument name="instanceName"
                    xsi:type="string">Les\ShippingNote\Virtual\GlobalDeliveryMessage</argument>
        </arguments>
    </virtualType>

    <type name="Les\ShippingNote\Block\Delivery\Summary">
        <arguments>
            <!-- 指定 Summary 使用另一個 Service -->
            <!-- 替換物件 -->
            <!-- 當 Magento 建立 Summary 時，將它的 deliveryMessage 參數指定為 InternationalDeliveryMessage 服務 -->
            <!--<argument name="deliveryMessage" xsi:type="object">Les\ShippingNote\Model\InternationalDeliveryMessage</argument>-->

            <!-- 指定 Summary 使用 Virtual Type A -->
            <!--<argument name="deliveryMessage" xsi:type="object">Les\ShippingNote\Virtual\GlobalDeliveryMessage</argument>-->

            <!-- 指定 Summary 使用 Proxy -->
            <argument name="deliveryMessage"
                    xsi:type="object">Les\ShippingNote\Virtual\LazyGlobalDeliveryMessage</argument>
        </arguments>
    </type>

    <type name="Les\ShippingNote\Model\Preview\NotePreview">
        <arguments>
            <argument name="source" xsi:type="object">Les\ShippingNote\Model\Preview\OrmNoteSource</argument>
            <argument name="heading" xsi:type="string">ORM delivery note preview</argument>
            <argument name="limit" xsi:type="number">3</argument>
            <argument name="showCodes" xsi:type="boolean">true</argument>
            <argument name="options" xsi:type="array">
                <item name="empty_message" xsi:type="string">No active ORM notes were found.</item>
            </argument>
        </arguments>
    </type>

</config>
