<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="les_shipping_note"
           resource="default"
           engine="innodb"
           comment="LES Shipping Notes">

        <column xsi:type="int"
                name="id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Note ID"/>

        <column xsi:type="varchar"
                name="code"
                length="64"
                nullable="false"
                comment="Note Code"/>

        <column xsi:type="varchar"
                name="title"
                length="255"
                nullable="false"
                comment="Note Title"/>

        <column xsi:type="text"
                name="content"
                nullable="true"
                comment="Note Content"/>

        <column xsi:type="smallint"
                name="is_active"
                unsigned="true"
                nullable="false"
                default="1"
                comment="Is Active"/>
        
        <column xsi:type="int"
                name="sort_order"
                unsigned="true"
                nullable="false"
                default="0"
                comment="Sort Order"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <constraint xsi:type="unique"
                    referenceId="LES_SHIPPING_NOTE_CODE">
            <column name="code"/>
        </constraint>

    </table>
</schema>
